SERVING_MODE=emulator
VITE_API_BASE_URL=

# Live API values are injected by Cloud Run in Terraform. Use these only for local
# live-mode testing with application-default credentials.
GCP_PROJECT=your-project-id
GCP_REGION=us-central1
BQ_DATASET=retail_demo
BQ_LOCATION=US
BQ_EMBEDDING_MODEL=gemini_embed
BT_INSTANCE=retail-features
BT_TABLE=online_features
BT_APP_PROFILE=serving
BT_COLUMN_FAMILY=f
PUBSUB_TOPIC=retail-live-events
ALLOYDB_HOST=10.0.0.10
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=retail
ALLOYDB_USER=retail_app
ALLOYDB_PASSWORD_SECRET=retail-alloydb-password
VERTEX_RANKING_ENDPOINT=projects/YOUR_PROJECT/locations/us-central1/endpoints/YOUR_ENDPOINT
VERTEX_PRICING_ENDPOINT=projects/YOUR_PROJECT/locations/us-central1/endpoints/YOUR_ENDPOINT
VERTEX_COUPON_ENDPOINT=projects/YOUR_PROJECT/locations/us-central1/endpoints/YOUR_ENDPOINT
FEATURE_FRESHNESS_SLA_SECONDS=120
